# ASODEF Platform — environment template. Never commit real values.

NODE_ENV=development

# App
APP_NAME=ASODEF
APP_DOMAIN=localhost
APP_TIMEZONE=America/Bogota
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# API
API_PORT=3000

# Database
DATABASE_URL=postgresql://asodef:asodef_dev_password@localhost:5433/asodef?schema=public
POSTGRES_DB=asodef
POSTGRES_USER=asodef
POSTGRES_PASSWORD=asodef_dev_password

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=dev_jwt_secret_change_me_min_16_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_16_chars
JWT_REFRESH_TTL=7d

# Used for future field-level encryption of sensitive data at rest (not yet
# implemented) — must be at least 32 characters.
ENCRYPTION_KEY=dev_encryption_key_change_me_needs_32_chars_min

# Bold payment provider — mock mode only until real sandbox credentials exist
BOLD_MODE=mock
BOLD_BASE_URL=https://api.online.payments.bold.co
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=
BOLD_WEBHOOK_SECRET=

# Production payments stay disabled until every legal/commercial approval gate is APPROVED
PRODUCTION_PAYMENTS_ENABLED=false

# SMTP / notifications. Leave SMTP_HOST empty to use the safe no-op
# transport (delivery is recorded as FAILED with reason SMTP_NOT_CONFIGURED,
# never claimed as sent). Set every SMTP_* value and confirm real delivery
# before treating outbound email as operational in any environment.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CORPORATE_EMAIL=info@asodef.com.co

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# Set to "true" only when running behind Nginx (production) so req.ip and
# X-Forwarded-* headers are trusted from the first proxy hop.
TRUST_PROXY=false

LOG_LEVEL=info

# Auth cookies (US-006). COOKIE_DOMAIN stays empty in every environment
# unless a specific reason requires it — no domain is hardcoded anywhere
# in the auth services.
COOKIE_ACCESS_TOKEN_NAME=asodef_at
COOKIE_REFRESH_TOKEN_NAME=asodef_rt
COOKIE_DOMAIN=

# Argon2id parameters (OWASP-recommended minimums)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Per-account lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# IP-based login rate limiting (Redis-backed fixed window)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Password recovery (US-007)
PASSWORD_RESET_TOKEN_SECRET=dev_reset_token_secret_change_me_min_16_chars
PASSWORD_RESET_TOKEN_TTL=1h

# Signed contract download tokens (US-055) - a dedicated pepper, distinct
# from PASSWORD_RESET_TOKEN_SECRET, so the blast radius of a leak stays
# contained to one purpose.
CONTRACT_DOWNLOAD_TOKEN_SECRET=dev_contract_download_secret_change_me_min_16_chars

# Centralized password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_HISTORY_LIMIT=5

# forgot-password rate limiting (by IP and by a hash of the normalized email)
FORGOT_PASSWORD_RATE_LIMIT_IP_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_IP_WINDOW_SECONDS=900
FORGOT_PASSWORD_RATE_LIMIT_IDENTIFIER_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_IDENTIFIER_WINDOW_SECONDS=900

# reset-password rate limiting (by IP)
RESET_PASSWORD_RATE_LIMIT_MAX=10
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# change-password rate limiting (failed current-password attempts, by user)
CHANGE_PASSWORD_RATE_LIMIT_MAX=5
CHANGE_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
