# ASODEF Platform — environment template. Never commit real values.

NODE_ENV=development

# App
APP_NAME=ASODEF
APP_DOMAIN=localhost
APP_TIMEZONE=America/Bogota
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# API
API_PORT=3000

# Database
DATABASE_URL=postgresql://asodef:asodef_dev_password@localhost:5433/asodef?schema=public
POSTGRES_DB=asodef
POSTGRES_USER=asodef
POSTGRES_PASSWORD=asodef_dev_password

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=dev_jwt_secret_change_me_min_16_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_16_chars
JWT_REFRESH_TTL=7d

# Used for future field-level encryption of sensitive data at rest (not yet
# implemented) — must be at least 32 characters.
ENCRYPTION_KEY=dev_encryption_key_change_me_needs_32_chars_min

# Bold payment provider — mock mode only until real sandbox credentials exist
BOLD_MODE=mock
BOLD_BASE_URL=https://api.online.payments.bold.co
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=
BOLD_WEBHOOK_SECRET=

# Production payments stay disabled until every legal/commercial approval gate is APPROVED
PRODUCTION_PAYMENTS_ENABLED=false

# SMTP / notifications (stub transport in Phase 1 — no real dispatch)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# Set to "true" only when running behind Nginx (production) so req.ip and
# X-Forwarded-* headers are trusted from the first proxy hop.
TRUST_PROXY=false

LOG_LEVEL=info
