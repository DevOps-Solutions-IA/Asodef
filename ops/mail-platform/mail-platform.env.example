# Non-secret deployment inputs. Copy outside the repository and protect with 0600.
MAIL_DOMAIN=asodef.com.co
MAIL_HOSTNAME=smtp.asodef.com.co
MAIL_PUBLIC_IPV4=169.58.36.138
MAIL_PUBLIC_INTERFACE=eth0
MAIL_NETWORK_NAME=asodef_mail_submission
MAIL_BRIDGE_NAME=asodef-mail0
MAIL_SUBNET=172.25.52.0/29
MAIL_GATEWAY=172.25.52.1
MAIL_API_ADDRESS=172.25.52.2
MAIL_LISTEN_ADDRESS=172.25.52.1
MAIL_API_CONTAINER=asodef-public-platform-production-api-1
MAIL_DKIM_SELECTOR=asodef2026a
MAIL_TLS_CERT_FILE=/etc/letsencrypt/live/smtp.asodef.com.co/fullchain.pem
MAIL_TLS_KEY_FILE=/etc/letsencrypt/live/smtp.asodef.com.co/privkey.pem
MAIL_ACME_WEBROOT=/var/www/certbot
MAIL_ACME_EMAIL=REPLACE_WITH_APPROVED_ACME_CONTACT
MAIL_SMTP_USER=REPLACE_WITH_DEDICATED_APPLICATION_IDENTITY
MAIL_SMTP_FROM=no-reply@asodef.com.co
MAIL_MESSAGE_SIZE_LIMIT=10485760
MAIL_OPERATOR_APPROVAL=NO

# Secret input is a root-owned file containing only the SMTP password.
# Never put its contents in this file, Git, shell history, process arguments, or logs.
MAIL_SMTP_PASSWORD_FILE=/etc/asodef/secrets/smtp-app-password
