{
  "name": "asodef-platform",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "prepare:generated": "turbo run prisma:generate --filter=@asodef/api",
    "ci:check": "bash scripts/ci-check.sh",
    "ci:verify": "bash scripts/ci-verify.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prisma:generate": "pnpm --filter api prisma:generate",
    "prisma:migrate": "pnpm --filter api prisma:migrate",
    "prisma:seed": "pnpm --filter api prisma:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "1.20.6",
      "glob": "10.5.0",
      "js-yaml": "4.3.1",
      "lodash": "4.18.0",
      "multer": "2.2.0",
      "picomatch": "4.0.4",
      "qs": "6.15.2",
      "tmp": "0.2.7"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ]
  }
}
