generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / RBAC core (US-003)
//
// Role and Permission are deliberately normalized relational tables, not
// enums: new roles (e.g. future business-partner or auditor variants) and
// new permission keys (one per module, added as later stories introduce
// modules) must not require a schema migration, only a data seed.
// UserStatus is a real Postgres enum: it is a small, well-understood,
// rarely-changing set, and Postgres enums support ALTER TYPE ADD VALUE if
// that ever changes.
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  // US-006: account lifecycle / lockout state. Preferred over deriving
  // lockout state by counting LoginAttempt rows on every request - this is
  // the fast, authoritative source the login path checks and updates.
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)

  // US-007: stamped on every successful password reset/change. JwtAuthGuard
  // rejects any already-issued access token whose `iat` predates this
  // timestamp - see the guard's doc comment for the full design rationale
  // (the smallest mechanism that gives near-immediate revocation of an
  // otherwise-stateless access token without a per-request session lookup).
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)

  roles                             UserRole[]
  sessions                          Session[]
  passwordResets                    PasswordReset[]
  passwordHistory                   PasswordHistoryEntry[]
  loginAttempts                     LoginAttempt[]
  securityEvents                    SecurityEvent[]
  notificationJobs                  NotificationJob[]
  approvedLegalDocumentVersions     LegalDocumentVersion[]     @relation("LegalDocumentVersionApprover")
  auditLogActions                   AuditLog[]                 @relation("AuditLogActor")
  consentRecords                    ConsentRecord[]
  assignedDataSubjectRequests       DataSubjectRequest[]       @relation("DataSubjectRequestAssignee")
  anonymizationLogActions           AnonymizationLog[]
  assignedProspects                 Prospect[]                 @relation("ProspectAssignee")
  assignedOpportunities             Opportunity[]              @relation("OpportunityAssignee")
  opportunityStageChanges           OpportunityStatusHistory[] @relation("OpportunityStatusChangedBy")
  assignedCommercialActivities      CommercialActivity[]       @relation("CommercialActivityAssignee")
  uploadedContractVersions          ContractVersion[]          @relation("ContractVersionUploader")
  issuedContractDownloadTokens      ContractDownloadToken[]    @relation("ContractDownloadTokenIssuer")
  approvedRefunds                   Refund[]                   @relation("RefundApprover")
  reconciliationRuns                Reconciliation[]
  resolvedReconciliationDifferences ReconciliationDifference[] @relation("ReconciliationDifferenceResolver")
  requestedExportJobs               ExportJob[]
  approvedApprovalGates             ApprovalGate[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

// Pure join table: the (userId, roleId) pair is itself the identity, so a
// composite primary key is used instead of a synthetic uuid.
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  REFRESH_TOKEN_REUSE_DETECTED
  ADMIN_ACTION
  PASSWORD_RESET
  PASSWORD_CHANGED
  EXPIRED_CLEANUP

  @@map("session_revocation_reason")
}

// A rotating refresh-token session (US-006). Each row represents exactly
// one generation of a refresh token. On rotation the old row is stamped
// rotatedAt + rotatedToSessionId and a *new* row is created sharing the
// same familyId; the old row's refreshTokenHash is never reused. If a
// refresh request ever matches a row that already has rotatedAt set, that
// is conclusive proof of reuse of an already-superseded token (either a
// client race or genuine theft) - REPLAY_DETECTED revokes every row
// sharing that familyId. Only a hash of the refresh token is ever stored;
// the raw token exists solely in the client's httpOnly cookie.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)

  // Rotation chain
  rotatedAt          DateTime? @map("rotated_at") @db.Timestamptz(3)
  rotatedToSessionId String?   @unique @map("rotated_to_session_id") @db.Uuid

  // Revocation (logout, logout-all, replay detection, admin action, ...)
  revokedAt     DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokedReason SessionRevocationReason? @map("revoked_reason")

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedToSession   Session?        @relation("SessionRotationChain", fields: [rotatedToSessionId], references: [id], onDelete: SetNull)
  rotatedFromSession Session?        @relation("SessionRotationChain")
  securityEvents     SecurityEvent[]

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// Password-reset token (US-003 skeleton, extended by US-007). Only a hash
// of the reset token is ever stored - see PasswordResetTokenService. At
// most one *active* (unused, unexpired, non-superseded) token exists per
// user at a time: requesting a new one supersedes every previous unused
// token (supersededAt stamped) - that is the documented invalidation
// policy. One-time-use is enforced atomically at the application layer
// (an updateMany claim with `usedAt: null` in the WHERE clause, the same
// concurrency-safe pattern SessionService.rotateSession uses). Never
// cascade-deleted from User, matching LoginAttempt/SecurityEvent: this is
// a security record and must survive account deactivation.
model PasswordReset {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  requestIp    String?   @map("request_ip")
  userAgent    String?   @map("user_agent")
  requestId    String?   @map("request_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_resets")
}

// One prior password hash per row, inserted immediately before the
// User's passwordHash is overwritten by a reset or change (US-007). Lets
// PasswordPolicyService reject reuse of a recent password
// (PASSWORD_HISTORY_LIMIT most recent rows) without keeping the check
// coupled to any single flow. Rows are never pruned by this story -
// retention/cleanup is a future governance-module concern, matching the
// "do not delete security evidence prematurely" instruction.
model PasswordHistoryEntry {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("password_history")
}

enum NotificationType {
  PASSWORD_RESET
  PASSWORD_CHANGED
  SECURITY_ALERT

  @@map("notification_type")
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED

  @@map("notification_status")
}

// Durable outbox row for every notification the platform attempts to send
// (US-007). Created synchronously in the same request with status
// QUEUED; a fire-and-forget dispatch immediately afterward (never awaited
// by the HTTP response) updates it to SENT or FAILED+failureReason - this
// row IS the queue, and its existence/terminal status is exactly what
// tests and future operational tooling inspect. Never stores the raw
// content of a password-reset link/token - only safe metadata.
model NotificationJob {
  id              String             @id @default(uuid()) @db.Uuid
  type            NotificationType
  status          NotificationStatus @default(QUEUED)
  recipientEmail  String             @map("recipient_email")
  userId          String?            @map("user_id") @db.Uuid
  correlationId   String             @map("correlation_id")
  templateVersion String             @map("template_version")
  retryCount      Int                @default(0) @map("retry_count")
  failureReason   String?            @map("failure_reason")
  sentAt          DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([correlationId])
  @@map("notification_jobs")
}

enum LoginFailureCategory {
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  ACCOUNT_INACTIVE
  ACCOUNT_SUSPENDED
  RATE_LIMITED

  @@map("login_failure_category")
}

// userId is a nullable, SetNull foreign key populated by server-side logic
// *after* the login flow has already resolved the account internally - it
// is never derived from unvalidated client input in a way that could
// itself fail/error and leak whether an email exists. Attempts against
// unknown emails are still fully recordable (userId simply stays null),
// which is what makes IP/email-based rate limiting and lockout analysis
// possible without ever revealing account existence in the public
// response. Never cascade-deleted - login-attempt history is a security
// record and must survive account deactivation.
model LoginAttempt {
  id              String                @id @default(uuid()) @db.Uuid
  email           String
  userId          String?               @map("user_id") @db.Uuid
  ipAddress       String?               @map("ip_address")
  userAgent       String?               @map("user_agent")
  success         Boolean
  failureCategory LoginFailureCategory? @map("failure_category")
  requestId       String?               @map("request_id")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

enum SecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SESSION_CREATED
  SESSION_REFRESHED
  REFRESH_TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_TOKEN_CREATED
  PASSWORD_RESET_SUCCEEDED
  PASSWORD_RESET_FAILED
  PASSWORD_RESET_TOKEN_EXPIRED
  PASSWORD_RESET_TOKEN_REUSED
  PASSWORD_CHANGED
  PASSWORD_CHANGE_FAILED
  PASSWORD_SESSIONS_REVOKED
  PASSWORD_NOTIFICATION_FAILED
  AUTHORIZATION_DENIED
  ROLE_ASSIGNED
  ROLE_REMOVED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  GOVERNANCE_CHANGE_ATTEMPTED
  SCOPE_VIOLATION_ATTEMPTED
  LOCKOUT_EXPIRED
  LOCKOUT_RATE_LIMITED
  ACCOUNT_UNLOCK_FAILED
  ADMINISTRATIVE_UNLOCK
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED

  @@map("security_event_type")
}

// Durable, append-only security event log (US-006). A full AuditLog module
// is a later story - this table is the typed abstraction that story will
// connect to (or subsume) without requiring the authentication domain to
// be rewritten. Never cascade-deleted from User/Session: security history
// must survive account deactivation and session cleanup alike. `metadata`
// must never contain passwords, tokens, token hashes, or cookies - only
// safe contextual fields (e.g. a familyId for a reuse-detected event).
model SecurityEvent {
  id        String            @id @default(uuid()) @db.Uuid
  type      SecurityEventType
  userId    String?           @map("user_id") @db.Uuid
  sessionId String?           @map("session_id") @db.Uuid
  ipAddress String?           @map("ip_address")
  userAgent String?           @map("user_agent")
  requestId String?           @map("request_id")
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

enum LeadStatus {
  PENDING
  REVIEWED
  ARCHIVED

  @@map("lead_status")
}

enum LeadNotificationStatus {
  PENDING
  SENT

  @@map("lead_notification_status")
}

// US-017: inbound partnership inquiries from the public "quiero ser
// aliado" form. Public-facing and unauthenticated, so every field is
// exactly what the visitor typed - never trusted for anything beyond
// display/follow-up (no role, permission, or internal linkage implied).
model LeadSubmission {
  id               String     @id @default(uuid()) @db.Uuid
  fullName         String     @map("full_name")
  company          String
  position         String
  city             String
  phone            String
  email            String
  sector           String
  message          String
  consentAccepted  Boolean    @map("consent_accepted")
  publicReference  String?    @unique @map("public_reference")
  source           String?
  entryRoute       String?    @map("entry_route")
  audience         String?
  need             String?
  preferredContact String?    @map("preferred_contact")
  campaign         Json?
  funnelPayload    Json?      @map("funnel_payload")
  idempotencyKey   String?    @unique @map("idempotency_key")
  status           LeadStatus @default(PENDING)
  // US-051: set once this lead is promoted into a Prospect via the
  // admin endpoint - nullable, never set at creation.
  prospectId       String?    @map("prospect_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification   LeadNotification?
  consentRecords ConsentRecord[]
  prospect       Prospect?         @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source, audience, need])
  @@map("lead_submissions")
}

// A persisted "pending" stub, not an actual dispatch - deliberately not
// reusing NotificationJob (that model is scoped to authenticated-user
// email flows: required recipientEmail/userId, a closed NotificationType
// enum, and a real MailTransport send). This is just the durable record
// the commercial team's follow-up tooling polls; no email is sent by
// this story.
model LeadNotification {
  id               String                 @id @default(uuid()) @db.Uuid
  leadSubmissionId String                 @unique @map("lead_submission_id") @db.Uuid
  status           LeadNotificationStatus @default(PENDING)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  leadSubmission LeadSubmission @relation(fields: [leadSubmissionId], references: [id], onDelete: Cascade)

  @@map("lead_notifications")
}

enum ContentStatus {
  DRAFT
  PUBLISHED

  @@map("content_status")
}

// US-020: a generic, extensible key/value store for homepage fields
// that should be editable without a code deploy (starting with
// hero.eyebrow). DRAFT rows are never returned by the public GET
// /content endpoint - only PUBLISHED. No admin mutation endpoint
// exists yet (out of scope for this story); rows are seeded via
// seed-content.ts and edited directly until a future admin-content
// story adds one.
model ContentEntry {
  id        String        @id @default(uuid()) @db.Uuid
  key       String        @unique
  value     String
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("content_entries")
}

// ---------------------------------------------------------------------------
// Payments domain (US-021)
//
// Schema/seed only - no API routes, no PaymentProvider integration, no
// frontend (later stories). Field lists match the PRD's own dataModel
// entries exactly (never extended beyond what's listed there). Every FK
// in this domain uses onDelete: Restrict - financial/audit records must
// never be silently cascade-deleted, same principle already applied to
// SecurityEvent/LoginAttempt elsewhere in this schema. amountCents is
// always Int (integer minor units) per the PRD's own rule: "never use
// floating-point arithmetic for money."
// ---------------------------------------------------------------------------

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("affiliate_status")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE

  @@map("company_status")
}

enum ObligationStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED

  @@map("obligation_status")
}

// The PRD's own rule text gives this exact enum verbatim: "Payment
// status enum is centrally defined once (DRAFT/PENDING/PROCESSING/
// APPROVED/REJECTED/FAILED/EXPIRED/CANCELLED/REFUNDED/
// PARTIALLY_REFUNDED)" - not inferred, copied directly from the rules
// array.
enum PaymentOrderStatus {
  DRAFT
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_order_status")
}

// A single attempt's own outcome - a smaller vocabulary than the parent
// order's full lifecycle, since an attempt either succeeds, fails, or
// expires; it never independently reaches REFUNDED/PARTIALLY_REFUNDED
// (those are order-level, post-approval states).
enum PaymentAttemptStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
  EXPIRED

  @@map("payment_attempt_status")
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  documentType   String   @map("document_type")
  documentNumber String   @map("document_number")
  fullName       String   @map("full_name")
  email          String
  phone          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  affiliates     Affiliate[]
  obligations    Obligation[]
  paymentOrders  PaymentOrder[]
  consentRecords ConsentRecord[]
  pqrCases       PqrCase[]
  contracts      Contract[]

  // Natural business key: US-021's own Example queries "the seeded demo
  // customer's document number", implying (type, number) uniquely
  // identifies a customer for lookup - matches the real-world Payment
  // Center's own lookup-by-document flow (later story).
  @@unique([documentType, documentNumber])
  @@map("customers")
}

model Affiliate {
  id              String          @id @default(uuid()) @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  affiliateNumber String          @unique @map("affiliate_number")
  status          AffiliateStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("affiliates")
}

model Company {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  nit          String        @unique
  contactName  String        @map("contact_name")
  contactEmail String        @map("contact_email")
  sector       String
  status       CompanyStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  commercialContacts CommercialContact[]
  opportunities      Opportunity[]
  agreements         Agreement[]
  contracts          Contract[]
  auditLogs          AuditLog[]

  @@map("companies")
}

// US-054: Plan is now a stable identity (mirrors LegalDocument's own
// identity/version split from US-043) - all rich, editable content
// lives on PlanVersion instead. description/active (US-021) moved
// into PlanVersion as part of that expansion; the "active" boolean is
// superseded by PlanVersion.status === ACTIVE.
model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  // @unique is a constraint on an existing PRD-listed field, not an
  // added field - needed so the seed script can upsert idempotently
  // (the PRD's dataModel gives no other natural unique key for Plan).
  name             String   @unique
  currentVersionId String?  @unique @map("current_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Restrict, not SetNull/Cascade: the currently-active version of a
  // plan must never be silently detached, same reasoning as
  // LegalDocument.currentVersion.
  currentVersion PlanVersion?  @relation("CurrentPlanVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions       PlanVersion[] @relation("PlanVersions")
  obligations    Obligation[]

  @@map("plans")
}

enum PlanVersionStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  RETIRED
  ARCHIVED

  @@map("plan_version_status")
}

// US-054: "taxes", "coverage", "eligibility", "beneficiaryRules",
// "terms", "cancellationRules", "renewalRules", "paymentConditions"
// have no PRD-given shape/enum - all kept as free-form text (or jsonb
// for the two explicitly list-shaped fields, includedServices and
// exclusions, mirroring BusinessPartner.benefitsOffered's precedent),
// never an invented structure.
model PlanVersion {
  id                String            @id @default(uuid()) @db.Uuid
  planId            String            @map("plan_id") @db.Uuid
  version           Int
  internalName      String            @map("internal_name")
  publicName        String            @map("public_name")
  description       String
  coverage          String?
  includedServices  Json?             @map("included_services")
  exclusions        Json?
  eligibility       String?
  beneficiaryRules  String?           @map("beneficiary_rules")
  priceCents        Int               @map("price_cents")
  billingFrequency  String            @map("billing_frequency")
  taxes             String?
  startDate         DateTime?         @map("start_date") @db.Timestamptz(3)
  endDate           DateTime?         @map("end_date") @db.Timestamptz(3)
  status            PlanVersionStatus @default(DRAFT)
  terms             String?
  cancellationRules String?           @map("cancellation_rules")
  renewalRules      String?           @map("renewal_rules")
  paymentConditions String?           @map("payment_conditions")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  plan           Plan           @relation("PlanVersions", fields: [planId], references: [id], onDelete: Restrict)
  currentForPlan Plan?          @relation("CurrentPlanVersion")
  paymentOrders  PaymentOrder[]

  // Version numbers are database-protected, same as
  // LegalDocumentVersion - never just an application-level MAX+1.
  @@unique([planId, version])
  @@index([planId, status])
  @@map("plan_versions")
}

model Obligation {
  id          String           @id @default(uuid()) @db.Uuid
  customerId  String           @map("customer_id") @db.Uuid
  planId      String           @map("plan_id") @db.Uuid
  concept     String
  amountCents Int              @map("amount_cents")
  currency    String           @default("COP")
  dueDate     DateTime         @map("due_date") @db.Timestamptz(3)
  status      ObligationStatus @default(PENDING)

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentOrders PaymentOrder[]

  @@index([customerId, status])
  @@map("obligations")
}

model PaymentOrder {
  id                    String             @id @default(uuid()) @db.Uuid
  // Cryptographically random, never the internal uuid/sequence exposed
  // as a guessable ordering - per the PRD's own rule on public
  // references.
  publicReference       String             @unique @map("public_reference")
  obligationId          String             @map("obligation_id") @db.Uuid
  customerId            String             @map("customer_id") @db.Uuid
  amountCents           Int                @map("amount_cents")
  currency              String             @default("COP")
  status                PaymentOrderStatus @default(DRAFT)
  // US-054: which exact PlanVersion was disclosed/accepted at the
  // moment of creation - nullable because orders created before this
  // story never captured it (existing data is never backfilled with
  // fabricated acceptance evidence), required in practice for every
  // order the service creates going forward.
  planVersionAcceptedId String?            @map("plan_version_accepted_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt             DateTime           @map("expires_at") @db.Timestamptz(3)

  obligation                Obligation                 @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  customer                  Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Restrict: the accepted plan version is immutable financial/legal
  // acceptance evidence and must never be silently detached.
  planVersionAccepted       PlanVersion?               @relation(fields: [planVersionAcceptedId], references: [id], onDelete: Restrict)
  attempts                  PaymentAttempt[]
  events                    PaymentEvent[]
  receipts                  PaymentReceipt[]
  auditLogs                 AuditLog[]
  pqrCases                  PqrCase[]
  refunds                   Refund[]
  reconciliationDifferences ReconciliationDifference[]

  @@index([customerId, status])
  @@index([obligationId])
  @@map("payment_orders")
}

model PaymentAttempt {
  id                  String               @id @default(uuid()) @db.Uuid
  paymentOrderId      String               @map("payment_order_id") @db.Uuid
  // Null until the attempt actually reaches the provider (Bold) and a
  // reference comes back - not every attempt necessarily gets that far.
  providerReferenceId String?              @map("provider_reference_id")
  status              PaymentAttemptStatus @default(PENDING)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  paymentOrder PaymentOrder         @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]

  @@index([paymentOrderId])
  @@map("payment_attempts")
}

model PaymentTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  paymentAttemptId  String   @map("payment_attempt_id") @db.Uuid
  boldTransactionId String?  @map("bold_transaction_id")
  // Bold's own raw status string, stored as-is (not a strict enum) -
  // Bold's exact status vocabulary isn't confirmed from public docs in
  // this session (see the PRD's own rule on UNVERIFIED fields); a later
  // story (US-022, BoldPaymentProvider) is where that gets resolved.
  // rawResponse below preserves the full payload regardless.
  status            String
  rawResponse       Json     @map("raw_response")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([paymentAttemptId])
  @@map("payment_transactions")
}

model PaymentEvent {
  id             String    @id @default(uuid()) @db.Uuid
  paymentOrderId String    @map("payment_order_id") @db.Uuid
  source         String
  eventType      String    @map("event_type")
  // Explicit unique index required by the acceptance criteria - Bold
  // webhook events are processed idempotently keyed on this (PRD rule).
  idempotencyKey String    @unique @map("idempotency_key")
  payload        Json
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@index([paymentOrderId])
  @@map("payment_events")
}

model PaymentReceipt {
  id               String   @id @default(uuid()) @db.Uuid
  paymentOrderId   String   @map("payment_order_id") @db.Uuid
  receiptNumber    String   @unique @map("receipt_number")
  verificationCode String   @map("verification_code")
  issuedAt         DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  // Null until the PDF is actually generated - receipt metadata (number,
  // verification code) can exist an instant before the file does.
  pdfPath          String?  @map("pdf_path")

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@index([paymentOrderId])
  @@map("payment_receipts")
}

// US-028: the durable, append-only audit trail for the payment domain -
// the "later story" SecurityEvent's own schema comment (US-006)
// pointed to. Scoped to PaymentOrder specifically (not a generic
// polymorphic audit table) because that is this story's literal scope
// ("Audit wiring for the payment domain"); a cross-domain AuditLog, if
// a later story needs one, is that story's own design decision to make
// - extending forward, never rewriting this one.
enum AuditSource {
  ORDER_CREATE
  BOLD_CREATE
  POLL
  WEBHOOK
  MANUAL
  // US-048: the public DSR submission flow, analogous to ORDER_CREATE.
  REQUEST_CREATE

  @@map("audit_source")
}

// US-043: generalized beyond the payment domain, exactly as this
// model's own original comment anticipated ("a cross-domain AuditLog,
// if a later story needs one, is that story's own design decision to
// make - extending forward, never rewriting this one"). paymentOrderId
// is now nullable and a new nullable legalDocumentVersionId sits
// alongside it - a real, referentially-integral FK per domain rather
// than a generic polymorphic entityType/entityId pair, matching this
// project's own preference for database-enforced constraints over
// application-only checks. A raw-SQL CHECK constraint (added by hand
// in this story's migration) enforces "exactly one of the two is set"
// at the database level - every pre-existing row already satisfies it
// (payment_order_id always set, legal_document_version_id always
// null), so this is a safe, non-destructive addition.
model AuditLog {
  id                     String      @id @default(uuid()) @db.Uuid
  paymentOrderId         String?     @map("payment_order_id") @db.Uuid
  legalDocumentVersionId String?     @map("legal_document_version_id") @db.Uuid
  // US-048: generalized to a 3rd domain, same "real per-domain FK, not
  // a polymorphic pair" pattern as the other two.
  dataSubjectRequestId   String?     @map("data_subject_request_id") @db.Uuid
  // US-050: generalized to a 4th domain, same pattern.
  pqrCaseId              String?     @map("pqr_case_id") @db.Uuid
  // US-051: generalized to a 5th domain, same pattern.
  opportunityId          String?     @map("opportunity_id") @db.Uuid
  // US-056: generalized to a 6th domain, same pattern.
  refundId               String?     @map("refund_id") @db.Uuid
  // US-074: generalized to a 7th domain, same pattern.
  companyId              String?     @map("company_id") @db.Uuid
  // US-043: who performed a MANUAL (human-triggered) action - always
  // null for the payment domain's own automated sources (webhook/poll/
  // order-create/bold-create); set for legal-workflow actions, which
  // are always a human admin acting through the API.
  actorUserId            String?     @map("actor_user_id") @db.Uuid
  action                 String
  previousStatus         String?     @map("previous_status")
  newStatus              String?     @map("new_status")
  // False for the negative-case AC: an attempted transition that was
  // blocked (e.g. an invalid regression) still gets an audit row -
  // "indicating no-op, not silence" - distinguished from a real
  // transition by this flag rather than by parsing `action` text.
  applied                Boolean     @default(true)
  source                 AuditSource
  metadata               Json?
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  paymentOrder         PaymentOrder?         @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  legalDocumentVersion LegalDocumentVersion? @relation(fields: [legalDocumentVersionId], references: [id], onDelete: Restrict)
  dataSubjectRequest   DataSubjectRequest?   @relation(fields: [dataSubjectRequestId], references: [id], onDelete: Restrict)
  pqrCase              PqrCase?              @relation(fields: [pqrCaseId], references: [id], onDelete: Restrict)
  opportunity          Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  refund               Refund?               @relation(fields: [refundId], references: [id], onDelete: Restrict)
  company              Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Audit history must survive even a (currently unsupported) user
  // deletion - same onDelete: SetNull precedent as SecurityEvent.userId.
  actorUser            User?                 @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([paymentOrderId, createdAt])
  @@index([legalDocumentVersionId, createdAt])
  @@index([dataSubjectRequestId, createdAt])
  @@index([pqrCaseId, createdAt])
  @@index([opportunityId, createdAt])
  @@index([refundId, createdAt])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

enum LegalDocumentVersionStatus {
  DRAFT
  LEGAL_REVIEW
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  REPLACED
  ARCHIVED

  @@map("legal_document_version_status")
}

// US-043. One row per document *type* (e.g. "términos y condiciones") -
// currentVersionId points at whichever LegalDocumentVersion is
// currently PUBLISHED for it (null until the first publish ever
// happens). `type` is deliberately a plain string, not a Prisma enum -
// no exhaustive value list is given anywhere in this story's own AC
// (the later US-044 seed story is what actually enumerates the real
// document types), and a plain string means seeding a new type never
// requires a schema migration.
model LegalDocument {
  id               String   @id @default(uuid()) @db.Uuid
  type             String
  title            String
  slug             String   @unique
  currentVersionId String?  @unique @map("current_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Restrict, not SetNull/Cascade: the currently-published version of
  // a legal document must never be silently detached or removed.
  currentVersion LegalDocumentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions       LegalDocumentVersion[] @relation("DocumentVersions")

  @@map("legal_documents")
}

model LegalDocumentVersion {
  id                 String                     @id @default(uuid()) @db.Uuid
  legalDocumentId    String                     @map("legal_document_id") @db.Uuid
  version            Int
  status             LegalDocumentVersionStatus @default(DRAFT)
  // Freely editable while status = DRAFT. Never mutated once the
  // version moves past DRAFT - approve() snapshots it into
  // approvedContent below, which is what publish()/public reads
  // actually serve.
  draftContent       Json                       @map("draft_content")
  // Null until approve() sets it (draftContent snapshot at the exact
  // moment of approval) - "draftContent may exist and be edited freely
  // without ever implying public approval" (PRD rule, verbatim).
  approvedContent    Json?                      @map("approved_content")
  effectiveDate      DateTime?                  @map("effective_date") @db.Timestamptz(3)
  expirationDate     DateTime?                  @map("expiration_date") @db.Timestamptz(3)
  changeSummary      String?                    @map("change_summary")
  // Evidence supporting this exact version. Paths and concise factual
  // bases only; source documents themselves and sensitive payloads are
  // never copied into the database.
  sourceTraceability Json?                      @map("source_traceability")
  approvedByUserId   String?                    @map("approved_by_user_id") @db.Uuid
  approvalDate       DateTime?                  @map("approval_date") @db.Timestamptz(3)
  publicationDate    DateTime?                  @map("publication_date") @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  legalDocument      LegalDocument   @relation("DocumentVersions", fields: [legalDocumentId], references: [id], onDelete: Restrict)
  currentForDocument LegalDocument?  @relation("CurrentVersion")
  approvedByUser     User?           @relation("LegalDocumentVersionApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  auditLogs          AuditLog[]
  consentRecords     ConsentRecord[]

  // Version numbers are deterministic and database-protected (PRD
  // rule, verbatim) - this constraint is what actually enforces it,
  // not just the application-level MAX(version)+1 computation.
  @@unique([legalDocumentId, version])
  @@index([legalDocumentId, status])
  @@map("legal_document_versions")
}

// ---------------------------------------------------------------------------
// Consent (US-046)
//
// ConsentPurpose is the literal, PRD-given catalog of 8 purpose keys
// (seeded, not user-editable). requiresPolicyVersion marks the purposes
// that must be tied to a specific LegalDocumentVersion to be recorded
// at all (terms_and_conditions, data_processing, cookie_preferences,
// payment_terms - the 4 purposes that correspond to one of the 11
// seeded legal document types, US-044) versus the ones that don't
// correspond to any seeded document today (commercial_communications,
// electronic_notifications, contract_acceptance, optional_marketing).
// This flag is the mechanism behind the story's own negative case
// ("without a resolvable policy version where one is required").
// ---------------------------------------------------------------------------

enum ConsentStatus {
  GRANTED
  DENIED
  REVOKED
  EXPIRED
  REPLACED

  @@map("consent_status")
}

model ConsentPurpose {
  id                    String   @id @default(uuid()) @db.Uuid
  key                   String   @unique
  requiresPolicyVersion Boolean  @default(false) @map("requires_policy_version")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  consentRecords ConsentRecord[]

  @@map("consent_purposes")
}

// The "subject" (who gave consent) is exactly one of userId /
// leadSubmissionId / customerId at creation time (enforced by
// ConsentService.record()'s discriminated-union parameter type) - a
// public contact-form or payment flow has no authenticated User to
// attach to, so this can't be a single required userId FK. Mirrors
// AuditLog's US-043 real-per-domain-FKs design rather than a generic
// polymorphic entityType/entityId pair. Subject FKs use onDelete:
// SetNull (evidence must outlive the subject, e.g. a future erasure
// request - matches AuditLog.actorUserId); consentPurposeId/
// legalDocumentVersionId use onDelete: Restrict (what the record is
// evidence *of* must never silently disappear from under it).
//
// The DB-level CHECK is deliberately "at most one" (<=1), not "exactly
// one" (=1): a "=1" check is incompatible with onDelete: SetNull on
// these same columns - deleting a subject nulls its FK out, which a
// "=1" check would then reject as a constraint violation on the very
// deletion that was supposed to succeed. A record legitimately reaching
// zero subjects (its subject was later deleted) is expected, durable
// evidence, not a data integrity error.
model ConsentRecord {
  id                     String        @id @default(uuid()) @db.Uuid
  consentPurposeId       String        @map("consent_purpose_id") @db.Uuid
  legalDocumentVersionId String?       @map("legal_document_version_id") @db.Uuid
  userId                 String?       @map("user_id") @db.Uuid
  leadSubmissionId       String?       @map("lead_submission_id") @db.Uuid
  customerId             String?       @map("customer_id") @db.Uuid
  status                 ConsentStatus @default(GRANTED)
  ipAddress              String?       @map("ip_address")
  userAgent              String?       @map("user_agent")
  source                 String
  acceptanceMethod       String        @map("acceptance_method")
  // US-047: purpose-specific structured context (e.g. { category:
  // "analytics" } for a cookie_preferences record) - never a substitute
  // for the typed columns above, only supplementary. Mirrors
  // AuditLog.metadata's own precedent for this kind of extensibility.
  metadata               Json?
  revokedAt              DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  consentPurpose       ConsentPurpose        @relation(fields: [consentPurposeId], references: [id], onDelete: Restrict)
  legalDocumentVersion LegalDocumentVersion? @relation(fields: [legalDocumentVersionId], references: [id], onDelete: Restrict)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  leadSubmission       LeadSubmission?       @relation(fields: [leadSubmissionId], references: [id], onDelete: SetNull)
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([consentPurposeId, createdAt])
  @@index([userId, createdAt])
  @@index([leadSubmissionId, createdAt])
  @@index([customerId, createdAt])
  @@map("consent_records")
}

// ---------------------------------------------------------------------------
// Data-subject-rights requests (US-048)
//
// Field list is the PRD's own literal dataModel entry for this entity,
// verbatim, plus one addition: publicReference. The PRD's field list
// doesn't include it, but the AC explicitly requires "a tracking
// reference" returned on submission and used for public, reference-only
// lookup - exposing the raw internal uuid as that reference would
// violate this project's own repeated "never expose internal ids
// publicly when a distinct public identifier exists" rule (see
// PaymentOrder.publicReference, LegalDocument.slug). identityVerificationStatus
// is a free string, not an enum - no PRD-confirmed exhaustive value set
// exists for it (same non-invention rule as LegalDocument.type).
// ---------------------------------------------------------------------------

enum DataSubjectRequestType {
  ACCESS
  CONSULTATION
  UPDATE
  CORRECTION
  DELETION
  REVOCATION
  PROOF_OF_AUTHORIZATION
  DATA_USE_INFORMATION
  COMPLAINT
  IDENTITY_VERIFICATION
  INCIDENT_REPORT

  @@map("data_subject_request_type")
}

enum DataSubjectRequestStatus {
  RECEIVED
  IDENTITY_VERIFICATION
  IN_REVIEW
  INFORMATION_REQUIRED
  RESOLVED
  REJECTED_WITH_REASON
  CLOSED

  @@map("data_subject_request_status")
}

model DataSubjectRequest {
  id                         String                   @id @default(uuid()) @db.Uuid
  publicReference            String                   @unique @map("public_reference")
  type                       DataSubjectRequestType
  requesterName              String                   @map("requester_name")
  requesterEmail             String                   @map("requester_email")
  requesterDocument          String                   @map("requester_document")
  identityVerificationStatus String?                  @map("identity_verification_status")
  description                String
  assignedUserId             String?                  @map("assigned_user_id") @db.Uuid
  dueDate                    DateTime?                @map("due_date") @db.Timestamptz(3)
  status                     DataSubjectRequestStatus @default(RECEIVED)
  resolution                 String?
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignedUser User?      @relation("DataSubjectRequestAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]

  @@index([status, createdAt])
  @@index([assignedUserId])
  @@map("data_subject_requests")
}

// ---------------------------------------------------------------------------
// Data retention policies and anonymization evidence (US-049)
//
// retentionPeriodDays is deliberately nullable and unconfigured for
// every seeded category (see seed-retention-policies.ts) - no real
// retention period exists anywhere in the PRD or codebase, and
// inventing one (e.g. a generic "2 years") would be exactly the kind
// of unconfirmed legal/regulatory determination this project never
// fabricates. A category with no configured period is never flagged by
// the review job - the mechanism is real and tested, but inert by
// default until compliance provides real numbers.
//
// legalHold is a per-category flag on the policy itself, not a
// per-record flag on every one of the 11 underlying tables - the AC's
// own first sentence describes both fields as belonging to
// RetentionPolicy; the negative case's "a record flagged with
// legalHold=true" is read as a RetentionPolicy row (a "record" in the
// generic database sense), not a business record in some other table.
// A category-wide hold is also a strictly safer default than a
// granular one this story would otherwise have to fabricate a design
// for across models it doesn't own the schema of.
// ---------------------------------------------------------------------------

enum RetentionRecordCategory {
  LEADS
  OPPORTUNITIES
  CONTRACTS
  PAYMENT_ORDERS
  APPROVED_TRANSACTIONS
  FAILED_TRANSACTIONS
  RECEIPTS
  PQR_CASES
  AUDIT_LOGS
  DOCUMENTS
  CONSENT_RECORDS

  @@map("retention_record_category")
}

model RetentionPolicy {
  id                  String                  @id @default(uuid()) @db.Uuid
  recordCategory      RetentionRecordCategory @unique @map("record_category")
  retentionPeriodDays Int?                    @map("retention_period_days")
  legalHold           Boolean                 @default(false) @map("legal_hold")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("retention_policies")
}

enum AnonymizationAction {
  ANONYMIZED
  DELETED

  @@map("anonymization_action")
}

// Evidence of an executed action - always the result of an explicit
// admin approval (AC: "requires an explicit admin approval... before
// anonymizing/deleting, writing an AnonymizationLog entry as
// evidence"), never a side effect of the review job itself, which only
// ever identifies candidates and writes nothing.
model AnonymizationLog {
  id             String                  @id @default(uuid()) @db.Uuid
  recordCategory RetentionRecordCategory @map("record_category")
  recordId       String                  @map("record_id") @db.Uuid
  action         AnonymizationAction
  reason         String
  actorUserId    String?                 @map("actor_user_id") @db.Uuid
  executedAt     DateTime                @default(now()) @map("executed_at") @db.Timestamptz(3)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([recordCategory, recordId])
  @@map("anonymization_logs")
}

// ---------------------------------------------------------------------------
// PQR case management (US-050)
//
// Field list is the PRD's own literal dataModel entry, verbatim, with
// two deliberate gaps left exactly as the PRD leaves them:
//
// - relatedContractId has no @relation - no Contract model exists yet
//   (a later CRM/contracts story); it's a bare, unconstrained uuid
//   column for forward compatibility. A future migration adds the real
//   FK once Contract exists - never guessed at here.
// - This story's own AC3 says case creation "triggers a CommunicationLog
//   entry (US-059) acknowledging receipt" - CommunicationLog is defined
//   by US-059, which itself depends on US-050 (dependsOn: ["US-046",
//   "US-050"]), so it cannot exist yet. That specific criterion is
//   BLOCKED, not invented; everything else in this story is real.
//
// category is a plain string, not an enum: the PRD's own field
// description is "P/Q/R/S + incident types" - the 4 base categories
// (petición/queja/reclamo/sugerencia) are confirmed, but "+ incident
// types" is an open, unenumerated extension the same non-invention
// rule applies to (matches LegalDocument.type's own precedent).
// priority and assignedTeam are plain strings for the same reason - no
// PRD-confirmed enumerated value sets exist for either.
// ---------------------------------------------------------------------------

enum PqrCaseStatus {
  RECEIVED
  ASSIGNED
  IN_REVIEW
  INFORMATION_REQUIRED
  RESOLVED
  CLOSED
  REOPENED

  @@map("pqr_case_status")
}

model PqrCase {
  id                    String        @id @default(uuid()) @db.Uuid
  caseNumber            String        @unique @map("case_number")
  category              String
  applicantName         String        @map("applicant_name")
  applicantContact      String        @map("applicant_contact")
  relatedCustomerId     String?       @map("related_customer_id") @db.Uuid
  relatedPaymentOrderId String?       @map("related_payment_order_id") @db.Uuid
  relatedContractId     String?       @map("related_contract_id") @db.Uuid
  description           String
  assignedTeam          String?       @map("assigned_team")
  priority              String?
  dueDate               DateTime?     @map("due_date") @db.Timestamptz(3)
  status                PqrCaseStatus @default(RECEIVED)
  resolution            String?
  satisfactionScore     Int?          @map("satisfaction_score")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  relatedCustomer     Customer?     @relation(fields: [relatedCustomerId], references: [id], onDelete: Restrict)
  relatedPaymentOrder PaymentOrder? @relation(fields: [relatedPaymentOrderId], references: [id], onDelete: Restrict)
  auditLogs           AuditLog[]

  @@index([status, createdAt])
  @@index([relatedCustomerId])
  @@index([relatedPaymentOrderId])
  @@map("pqr_cases")
}

// ---------------------------------------------------------------------------
// CRM core: prospects, commercial contacts, opportunities, pipeline
// (US-051)
//
// Field lists are the PRD's own literal dataModel entries, verbatim.
// The 14-stage pipeline enum is shared by Prospect.stage and
// Opportunity.stage (a prospect's own stage is a coarser summary; an
// opportunity - created once a prospect is being actively pursued -
// tracks its own stage independently, since one prospect can have more
// than one opportunity over time, e.g. a renewal cycle).
//
// documentOrNit and type have no PRD-given default/derivation rule for
// lead promotion (LeadSubmission never collects either) - the
// promotion endpoint requires them as explicit admin input rather than
// guessing.
// ---------------------------------------------------------------------------

enum ProspectType {
  INDIVIDUAL
  COMPANY

  @@map("prospect_type")
}

// Verbatim order from the AC - this literal order is also what
// CrmService's "was this stage change a forward skip" warning logic
// (US-051's own negative case) walks to detect skipped intermediate
// stages within the primary funnel (index 0-9); the 4 trailing states
// (inactive/lost_opportunity/renewal_pending/contract_expired) are
// side/terminal states reachable from various points, not part of that
// linear skip-detection walk.
enum CommercialPipelineStage {
  NEW_PROSPECT
  CONTACTED
  QUALIFIED
  COMMERCIAL_MEETING
  PROPOSAL_PREPARATION
  PROPOSAL_SUBMITTED
  NEGOTIATION
  LEGAL_REVIEW
  CONTRACT_PENDING
  ACTIVE_PARTNER
  INACTIVE
  LOST_OPPORTUNITY
  RENEWAL_PENDING
  CONTRACT_EXPIRED

  @@map("commercial_pipeline_stage")
}

model Prospect {
  id                  String                  @id @default(uuid()) @db.Uuid
  type                ProspectType
  fullNameOrLegalName String                  @map("full_name_or_legal_name")
  documentOrNit       String                  @map("document_or_nit")
  sector              String?
  city                String?
  source              String?
  assignedUserId      String?                 @map("assigned_user_id") @db.Uuid
  stage               CommercialPipelineStage @default(NEW_PROSPECT)
  estimatedValueCents Int?                    @map("estimated_value_cents")
  probability         Int?
  expectedClosingDate DateTime?               @map("expected_closing_date") @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignedUser       User?               @relation("ProspectAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  commercialContacts CommercialContact[]
  opportunities      Opportunity[]
  promotedLeads      LeadSubmission[]

  @@index([stage])
  @@index([assignedUserId])
  @@map("prospects")
}

model CommercialContact {
  id         String  @id @default(uuid()) @db.Uuid
  prospectId String  @map("prospect_id") @db.Uuid
  companyId  String? @map("company_id") @db.Uuid
  fullName   String  @map("full_name")
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean @default(false) @map("is_primary")

  prospect         Prospect          @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  businessPartners BusinessPartner[]

  @@index([prospectId])
  @@map("commercial_contacts")
}

model Opportunity {
  id                  String                  @id @default(uuid()) @db.Uuid
  prospectId          String                  @map("prospect_id") @db.Uuid
  companyId           String?                 @map("company_id") @db.Uuid
  assignedUserId      String?                 @map("assigned_user_id") @db.Uuid
  stage               CommercialPipelineStage @default(NEW_PROSPECT)
  estimatedValueCents Int?                    @map("estimated_value_cents")
  proposedBenefit     String?                 @map("proposed_benefit")
  expectedClosingDate DateTime?               @map("expected_closing_date") @db.Timestamptz(3)
  probability         Int?
  wonLostReason       String?                 @map("won_lost_reason")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  prospect      Prospect                   @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  company       Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedUser  User?                      @relation("OpportunityAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  statusHistory OpportunityStatusHistory[]
  activities    CommercialActivity[]
  auditLogs     AuditLog[]
  proposals     Proposal[]
  agreements    Agreement[]

  @@index([stage])
  @@index([prospectId])
  @@map("opportunities")
}

model OpportunityStatusHistory {
  id              String                   @id @default(uuid()) @db.Uuid
  opportunityId   String                   @map("opportunity_id") @db.Uuid
  fromStage       CommercialPipelineStage? @map("from_stage")
  toStage         CommercialPipelineStage  @map("to_stage")
  changedByUserId String?                  @map("changed_by_user_id") @db.Uuid
  note            String?
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  changedByUser User?       @relation("OpportunityStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
  @@map("opportunity_status_history")
}

enum CommercialActivityType {
  CALL
  MEETING
  EMAIL
  TASK

  @@map("commercial_activity_type")
}

model CommercialActivity {
  id             String                 @id @default(uuid()) @db.Uuid
  opportunityId  String                 @map("opportunity_id") @db.Uuid
  type           CommercialActivityType
  dueDate        DateTime?              @map("due_date") @db.Timestamptz(3)
  completedAt    DateTime?              @map("completed_at") @db.Timestamptz(3)
  assignedUserId String?                @map("assigned_user_id") @db.Uuid
  note           String?
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity  Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  assignedUser User?       @relation("CommercialActivityAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([assignedUserId, completedAt])
  @@map("commercial_activities")
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED

  @@map("proposal_status")
}

model Proposal {
  id            String         @id @default(uuid()) @db.Uuid
  opportunityId String         @map("opportunity_id") @db.Uuid
  version       Int
  content       Json
  status        ProposalStatus @default(DRAFT)
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, version])
  @@map("proposals")
}

// US-052: no PRD-given enum for Agreement.status (unlike Proposal's
// explicit draft/sent/accepted/rejected) - kept a free-form nullable
// string rather than inventing a closed set, same precedent as
// LegalDocument.type.
model Agreement {
  id            String    @id @default(uuid()) @db.Uuid
  opportunityId String    @map("opportunity_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  status        String?
  signedDate    DateTime? @map("signed_date") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([opportunityId])
  @@map("agreements")
}

// US-053: the AC names a "9-state enum PROSPECT..ARCHIVED" but only
// gives the first and last state - the other 7 intermediate state
// names are never enumerated anywhere in the PRD. Inventing them would
// violate the standing "never invent business rules/taxonomies not
// explicitly confirmed" rule, so `status` stays a free-form string
// (same precedent as LegalDocument.type/Agreement.status) rather than
// a closed Prisma enum. Same reasoning applies to approvalStatus and
// publicationStatus - no PRD-given value sets exist for either.
// BLOCKED pending an explicit list of the 9 status values from
// someone with business/commercial authority over the partner
// lifecycle.
//
// The 7 gate-check booleans below map 1:1 to the AC's own literal
// list ("legal validation, commercial validation, benefit
// confirmation, agreement-validity confirmation, logo authorization,
// contact confirmation, and coverage confirmation") - note this is 7
// checks, while the PRD's own qualityGates section elsewhere says
// "all 6 checks" for this same gate. This numbering inconsistency is
// flagged, not silently resolved: the implementation follows the
// literal 7-item list from this story's own acceptanceCriteria text.
model BusinessPartner {
  id                  String    @id @default(uuid()) @db.Uuid
  legalName           String    @map("legal_name")
  tradeName           String    @map("trade_name")
  nit                 String    @unique
  sector              String
  city                String
  address             String
  phone               String
  corporateEmail      String    @map("corporate_email")
  website             String?
  legalRepresentative String?   @map("legal_representative")
  commercialContactId String?   @map("commercial_contact_id") @db.Uuid
  agreementType       String    @map("agreement_type")
  benefitsOffered     Json      @map("benefits_offered")
  discountConditions  String?   @map("discount_conditions")
  geographicCoverage  String?   @map("geographic_coverage")
  validFrom           DateTime? @map("valid_from") @db.Timestamptz(3)
  validUntil          DateTime? @map("valid_until") @db.Timestamptz(3)
  logoPath            String?   @map("logo_path")
  status              String    @default("PROSPECT")
  approvalStatus      String?   @map("approval_status")
  publicationStatus   String    @default("UNPUBLISHED") @map("publication_status")
  internalNotes       String?   @map("internal_notes")

  // Publication-gate checks (AC's own literal 7-item list) - all must
  // be true before publish() is permitted.
  legalValidationConfirmed      Boolean @default(false) @map("legal_validation_confirmed")
  commercialValidationConfirmed Boolean @default(false) @map("commercial_validation_confirmed")
  benefitConfirmed              Boolean @default(false) @map("benefit_confirmed")
  agreementValidityConfirmed    Boolean @default(false) @map("agreement_validity_confirmed")
  logoAuthorizationConfirmed    Boolean @default(false) @map("logo_authorization_confirmed")
  contactConfirmed              Boolean @default(false) @map("contact_confirmed")
  coverageConfirmed             Boolean @default(false) @map("coverage_confirmed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  commercialContact CommercialContact? @relation(fields: [commercialContactId], references: [id], onDelete: SetNull)

  @@index([publicationStatus])
  @@map("business_partners")
}

enum ContractStatus {
  DRAFT
  UNDER_REVIEW
  PENDING_ACCEPTANCE
  ACTIVE
  EXPIRED
  CANCELLED
  ARCHIVED

  @@map("contract_status")
}

// US-055: "type" has no PRD-given enum, kept a free-form string (same
// precedent as Agreement.status/BusinessPartner.status). Mirrors
// Plan/PlanVersion's identity+version split exactly: Contract is the
// stable identity, ContractVersion carries the actual document.
model Contract {
  id                String         @id @default(uuid()) @db.Uuid
  type              String
  relatedCompanyId  String?        @map("related_company_id") @db.Uuid
  relatedCustomerId String?        @map("related_customer_id") @db.Uuid
  internalReference String         @map("internal_reference")
  currentVersionId  String?        @unique @map("current_version_id") @db.Uuid
  status            ContractStatus @default(DRAFT)
  effectiveDate     DateTime?      @map("effective_date") @db.Timestamptz(3)
  expirationDate    DateTime?      @map("expiration_date") @db.Timestamptz(3)
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  relatedCompany  Company?          @relation(fields: [relatedCompanyId], references: [id], onDelete: SetNull)
  relatedCustomer Customer?         @relation(fields: [relatedCustomerId], references: [id], onDelete: SetNull)
  // Restrict, not SetNull/Cascade: same reasoning as
  // LegalDocument/Plan's own currentVersion pointer.
  currentVersion  ContractVersion?  @relation("CurrentContractVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions        ContractVersion[] @relation("ContractVersions")

  @@index([status])
  @@map("contracts")
}

// documentPath is a private filesystem path (CONTRACTS_STORAGE_DIR),
// never served directly - only through a signed, time-limited,
// permission-checked download token (ContractDownloadToken). checksum
// is server-computed (SHA-256 of the uploaded bytes), never trusted
// from the client.
model ContractVersion {
  id              String   @id @default(uuid()) @db.Uuid
  contractId      String   @map("contract_id") @db.Uuid
  version         Int
  documentPath    String   @map("document_path")
  checksum        String
  changeSummary   String?  @map("change_summary")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contract           Contract                @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Restrict)
  currentForContract Contract?               @relation("CurrentContractVersion")
  createdByUser      User?                   @relation("ContractVersionUploader", fields: [createdByUserId], references: [id], onDelete: SetNull)
  signers            ContractSigner[]
  acceptances        ContractAcceptance[]
  downloadTokens     ContractDownloadToken[]

  @@unique([contractId, version])
  @@map("contract_versions")
}

// role has no PRD-given enum (e.g. "legal representative", "witness")
// - free-form string, same precedent as elsewhere in this schema.
model ContractSigner {
  id                String  @id @default(uuid()) @db.Uuid
  contractVersionId String  @map("contract_version_id") @db.Uuid
  fullName          String  @map("full_name")
  role              String?
  email             String

  contractVersion ContractVersion      @relation(fields: [contractVersionId], references: [id], onDelete: Restrict)
  acceptances     ContractAcceptance[]

  @@index([contractVersionId])
  @@map("contract_signers")
}

model ContractAcceptance {
  id                String   @id @default(uuid()) @db.Uuid
  contractVersionId String   @map("contract_version_id") @db.Uuid
  signerId          String   @map("signer_id") @db.Uuid
  acceptedAt        DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ipAddress         String?  @map("ip_address")
  evidenceReference String?  @map("evidence_reference")

  contractVersion ContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Restrict)
  signer          ContractSigner  @relation(fields: [signerId], references: [id], onDelete: Restrict)

  // A given signer can accept a given version at most once - protects
  // the "all required signers have accepted" count from being
  // artificially inflated by an accidental duplicate submission.
  @@unique([contractVersionId, signerId])
  @@map("contract_acceptances")
}

// Mirrors PasswordResetToken's exact security pattern: only an
// HMAC-SHA256 hash of the raw token is ever persisted (see
// ContractDownloadTokenService). Reusable (not single-use) within its
// TTL window, matching standard signed-URL semantics (e.g. S3
// presigned URLs) - the AC only requires expiry (410), not
// single-use consumption.
model ContractDownloadToken {
  id                String   @id @default(uuid()) @db.Uuid
  contractVersionId String   @map("contract_version_id") @db.Uuid
  tokenHash         String   @unique @map("token_hash")
  issuedByUserId    String?  @map("issued_by_user_id") @db.Uuid
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contractVersion ContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Restrict)
  issuedByUser    User?           @relation("ContractDownloadTokenIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("contract_download_tokens")
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  FAILED

  @@map("refund_status")
}

// US-056: no PRD-given enum for Refund.status - PENDING_APPROVAL/
// APPROVED/FAILED are the 3 states this story's own workflow actually
// drives (request -> pending, approve+provider-call succeeds ->
// approved, provider call fails -> failed). No "rejected" endpoint is
// built - out of scope, not asked for by this story's literal AC.
model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentOrderId    String       @map("payment_order_id") @db.Uuid
  amountCents       Int          @map("amount_cents")
  reason            String
  evidencePath      String?      @map("evidence_path")
  status            RefundStatus @default(PENDING_APPROVAL)
  approvedByUserId  String?      @map("approved_by_user_id") @db.Uuid
  providerReference String?      @map("provider_reference")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  paymentOrder   PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  approvedByUser User?        @relation("RefundApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  auditLogs      AuditLog[]

  @@index([paymentOrderId])
  @@map("refunds")
}

// US-057: no PRD-given enum for either resolutionStatus field - the
// AC's own "each independently resolvable with notes" implies exactly
// two meaningful states (still needs attention / resolved), so a real
// Prisma enum is used rather than a free-form string (unlike fields
// with genuinely no discernible closed set, e.g. Agreement.status).
enum ReconciliationResolutionStatus {
  OPEN
  RESOLVED

  @@map("reconciliation_resolution_status")
}

// The 7 mismatch kinds are the AC's own literal, fully-enumerated list
// (unlike BusinessPartner's blocked 9-state case) - a real enum.
enum ReconciliationDifferenceKind {
  PROVIDER_APPROVED_INTERNALLY_PENDING
  INTERNAL_APPROVED_NO_PROVIDER_CONFIRMATION
  DUPLICATE_EVENT
  AMOUNT_MISMATCH
  REFERENCE_MISMATCH
  UNPROCESSED_NOTIFICATION
  REFUND_INCONSISTENCY

  @@map("reconciliation_difference_kind")
}

// rangeStart/rangeEnd aren't in the PRD's own sparse dataModel list for
// this entity, but are added because the AC's own literal text requires
// them functionally ("compares ... for a date range") - runDate alone
// (when dataModel says the run itself happened) can't express a range.
model Reconciliation {
  id                String                         @id @default(uuid()) @db.Uuid
  runDate           DateTime                       @default(now()) @map("run_date") @db.Timestamptz(3)
  rangeStart        DateTime                       @map("range_start") @db.Timestamptz(3)
  rangeEnd          DateTime                       @map("range_end") @db.Timestamptz(3)
  responsibleUserId String                         @map("responsible_user_id") @db.Uuid
  differencesFound  Int                            @default(0) @map("differences_found")
  resolutionStatus  ReconciliationResolutionStatus @default(OPEN) @map("resolution_status")
  notes             String?
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)

  responsibleUser User                       @relation(fields: [responsibleUserId], references: [id], onDelete: Restrict)
  differences     ReconciliationDifference[]

  @@index([rangeStart, rangeEnd])
  @@map("reconciliations")
}

// paymentOrderId nullable per the PRD dataModel - not every difference
// is traceable to one specific order (e.g. an orphaned notification).
model ReconciliationDifference {
  id               String                         @id @default(uuid()) @db.Uuid
  reconciliationId String                         @map("reconciliation_id") @db.Uuid
  paymentOrderId   String?                        @map("payment_order_id") @db.Uuid
  kind             ReconciliationDifferenceKind
  details          Json
  resolutionStatus ReconciliationResolutionStatus @default(OPEN) @map("resolution_status")
  resolutionNotes  String?                        @map("resolution_notes")
  // US-063 AC2: "a resolution workflow (notes, resolved-by, resolved-
  // at)" - US-057 shipped resolutionNotes but never these two; added
  // here as a forward-only migration, not a rewrite of that one.
  // resolvedByUserId is SetNull (not Restrict) since it's an audit
  // convenience field, not immutable financial evidence the way e.g.
  // Refund.approvedByUserId is - resolutionNotes/resolutionStatus
  // remain the durable record even if the resolving user is later
  // deleted.
  resolvedByUserId String?                        @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?                      @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)

  reconciliation Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  paymentOrder   PaymentOrder?  @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  resolvedByUser User?          @relation("ReconciliationDifferenceResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  // Same-issue de-duplication: at most one difference of a given kind
  // per order may exist at a time (Negative case AC - re-running
  // reconciliation must never duplicate an already-tracked issue,
  // resolved or not).
  @@unique([paymentOrderId, kind])
  @@index([reconciliationId])
  @@map("reconciliation_differences")
}

enum ApprovalGateStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED

  @@map("approval_gate_status")
}

// US-058: the AC's own prose lists 16 comma-separated gate names (NIT,
// legal address, corporate email, legal representative, commercial
// registration, privacy policy, data-processing policy, terms and
// conditions, payment policy, refund/reversal procedure, PQR process,
// plan/service conditions, Bold production credentials, HTTPS, webhook
// validation, customer-service ownership) while the same AC line
// states "15 required gates" - a PRD numbering inconsistency, same
// category as US-044's "10 vs 11" and US-053's "6 vs 7 checks". Per
// this session's established precedent, the literal enumerated list is
// the testable instruction - all 16 are seeded (see
// approval-gate-catalog.ts), and this discrepancy is flagged here
// rather than silently resolved by dropping one.
model ApprovalGate {
  id                     String             @id @default(uuid()) @db.Uuid
  key                    String             @unique
  description            String
  status                 ApprovalGateStatus @default(PENDING)
  approvedByUserId       String?            @map("approved_by_user_id") @db.Uuid
  approvalDate           DateTime?          @map("approval_date") @db.Timestamptz(3)
  supportingDocumentPath String?            @map("supporting_document_path")
  notes                  String?
  expirationDate         DateTime?          @map("expiration_date") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  approvedByUser User? @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@map("approval_gates")
}

enum CommunicationKind {
  TRANSACTIONAL
  MARKETING

  @@map("communication_kind")
}

// US-059: the AC's own literal example text uses lowercase status
// strings ('sent', 'suppressed', 'would-send') inconsistently (see
// CommunicationLogStatus's own comment below) - values here still
// follow this schema's own established SCREAMING_CASE convention for
// every other status enum, matching every prior story's precedent.
// channel has no PRD-given enum (e.g. "email"/"whatsapp"/"sms") - kept
// a free-form string, same precedent as elsewhere in this schema.
model CommunicationTemplate {
  id        String            @id @default(uuid()) @db.Uuid
  key       String            @unique
  channel   String
  kind      CommunicationKind
  subject   String?
  body      Json
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  logs CommunicationLog[]

  @@map("communication_templates")
}

// US-059: the AC's own bullet 2 says the granted-consent success case
// persists as 'would-send', but the AC's own Example (bullet 4) says
// the exact same case "logs status='sent'" - an internal PRD
// inconsistency (same category as US-044/US-053/US-058's own flagged
// numbering conflicts). The Example is treated as the more literal,
// testable instruction per this session's established precedent, so
// the success state is named SENT (mapped from 'sent'), not
// 'WOULD_SEND'. FAILED exists for a genuine internal dispatch error
// (not exercised by either AC scenario, but the only state that would
// ever populate the PRD-given errorCategory field for a reason other
// than suppression).
enum CommunicationLogStatus {
  SENT
  SUPPRESSED
  FAILED

  @@map("communication_log_status")
}

model CommunicationLog {
  id            String                 @id @default(uuid()) @db.Uuid
  templateId    String                 @map("template_id") @db.Uuid
  recipient     String
  channel       String
  status        CommunicationLogStatus
  attempts      Int                    @default(1)
  errorCategory String?                @map("error_category")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt        DateTime?              @map("sent_at") @db.Timestamptz(3)

  template CommunicationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([recipient, channel])
  @@index([templateId, createdAt])
  @@map("communication_logs")
}

model SuppressionListEntry {
  id        String   @id @default(uuid()) @db.Uuid
  channel   String
  recipient String
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // dataModel's own "(unique per channel)" annotation on recipient.
  @@unique([channel, recipient])
  @@map("suppression_list_entries")
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  READY
  FAILED

  @@map("export_job_status")
}

// US-064 AC2: "large exports (>1000 rows) run via a background job with
// a downloadable-when-ready state." No job-queue library exists
// anywhere in this codebase yet (only Redis for rate limiting) - rather
// than adding a new dependency for the one story that needs it, this is
// a DB-tracked job row processed by a plain in-process async task
// (ReportsService), same "no invented infrastructure beyond what's
// asked for" discipline as everywhere else this session. filePath
// mirrors Refund.evidencePath/ContractVersion.documentPath - never
// exposed directly, only served through an authenticated download
// route.
model ExportJob {
  id                String          @id @default(uuid()) @db.Uuid
  reportKey         String          @map("report_key")
  filters           Json
  status            ExportJobStatus @default(PENDING)
  rowCount          Int?            @map("row_count")
  filePath          String?         @map("file_path")
  errorMessage      String?         @map("error_message")
  requestedByUserId String          @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(3)

  // US-076: durable-queue fields, resolving the preproduction technical
  // debt the original comment above documented ("if the process
  // restarts mid-export the job simply stays PROCESSING forever").
  // Postgres-native, atomic-claim-based - evaluated against adding
  // BullMQ/Redis and rejected as unnecessary infrastructure for this
  // deployment's export volume (see ReportsService's own doc comment
  // for the full decision record).
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  attemptCount   Int       @default(0) @map("attempt_count")
  maxAttempts    Int       @default(3) @map("max_attempts")
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  failedAt       DateTime? @map("failed_at") @db.Timestamptz(3)

  requestedByUser User @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([requestedByUserId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("export_jobs")
}

// Isolated authentication records for the external-core-backed affiliate and
// company portals. These tokens never participate in staff JWT/RBAC sessions.
enum SelfServicePortal {
  AFFILIATE
  COMPANY

  @@map("self_service_portal")
}

enum SelfServiceChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED

  @@map("self_service_challenge_status")
}

enum SelfServiceContactUpdateStatus {
  DRAFT
  CHALLENGE_PENDING
  VERIFIED
  SUBMITTED
  APPLIED
  REJECTED
  LOCKED

  @@map("self_service_contact_update_status")
}

model SelfServiceOtpChallenge {
  id                  String                     @id @default(uuid()) @db.Uuid
  accessLookupId      String                     @map("access_lookup_id") @db.Uuid
  portal              SelfServicePortal
  lookupHash          String                     @map("lookup_hash")
  subjectRefEncrypted String                     @map("subject_ref_encrypted")
  browserBindingHash  String                     @map("browser_binding_hash")
  channel             String
  channelReference    String                     @map("channel_reference")
  destinationMasked   String                     @map("destination_masked")
  codeHash            String                     @map("code_hash")
  status              SelfServiceChallengeStatus @default(PENDING)
  attempts            Int                        @default(0)
  maxAttempts         Int                        @default(5) @map("max_attempts")
  expiresAt           DateTime                   @map("expires_at") @db.Timestamptz(3)
  retryAvailableAt    DateTime                   @map("retry_available_at") @db.Timestamptz(3)
  verifiedAt          DateTime?                  @map("verified_at") @db.Timestamptz(3)
  lockedAt            DateTime?                  @map("locked_at") @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  accessLookup SelfServiceAccessLookup @relation(fields: [accessLookupId], references: [id], onDelete: Restrict)
  sessions     SelfServiceSession[]

  @@index([lookupHash, createdAt])
  @@index([accessLookupId])
  @@index([status, expiresAt])
  @@map("self_service_otp_challenges")
}

model SelfServiceAccessLookup {
  id                    String            @id @default(uuid()) @db.Uuid
  portal                SelfServicePortal
  lookupHash            String            @map("lookup_hash")
  subjectRefEncrypted   String            @map("subject_ref_encrypted")
  browserBindingHash    String            @map("browser_binding_hash")
  channels              Json
  destinationsEncrypted String            @map("destinations_encrypted")
  expiresAt             DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  challenges SelfServiceOtpChallenge[]

  @@index([lookupHash, createdAt])
  @@index([expiresAt])
  @@map("self_service_access_lookups")
}

model SelfServiceSession {
  id                  String            @id @default(uuid()) @db.Uuid
  challengeId         String            @map("challenge_id") @db.Uuid
  portal              SelfServicePortal
  subjectRefEncrypted String            @map("subject_ref_encrypted")
  tokenHash           String            @unique @map("token_hash")
  csrfTokenHash       String            @map("csrf_token_hash")
  scopes              String[]
  assurance           String
  ipHash              String?           @map("ip_hash")
  userAgentHash       String?           @map("user_agent_hash")
  expiresAt           DateTime          @map("expires_at") @db.Timestamptz(3)
  lastUsedAt          DateTime?         @map("last_used_at") @db.Timestamptz(3)
  revokedAt           DateTime?         @map("revoked_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  challenge       SelfServiceOtpChallenge    @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  idempotencyKeys SelfServiceIdempotency[]
  contactUpdates  SelfServiceContactUpdate[]

  @@index([portal, expiresAt])
  @@index([challengeId])
  @@map("self_service_sessions")
}

model SelfServiceContactUpdate {
  id                   String                         @id @default(uuid()) @db.Uuid
  sessionId            String                         @map("session_id") @db.Uuid
  channel              String
  destinationEncrypted String                         @map("destination_encrypted")
  destinationMasked    String                         @map("destination_masked")
  browserBindingHash   String                         @map("browser_binding_hash")
  codeHash             String?                        @map("code_hash")
  status               SelfServiceContactUpdateStatus @default(DRAFT)
  attempts             Int                            @default(0)
  maxAttempts          Int                            @default(5) @map("max_attempts")
  expiresAt            DateTime                       @map("expires_at") @db.Timestamptz(3)
  retryAvailableAt     DateTime                       @map("retry_available_at") @db.Timestamptz(3)
  verifiedAt           DateTime?                      @map("verified_at") @db.Timestamptz(3)
  providerReference    String?                        @map("provider_reference")
  appliedAt            DateTime?                      @map("applied_at") @db.Timestamptz(3)
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)

  session SelfServiceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@index([status, expiresAt])
  @@index([providerReference])
  @@map("self_service_contact_updates")
}

model SelfServiceIdempotency {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  operation   String
  key         String
  requestHash String   @map("request_hash")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session SelfServiceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, operation, key])
  @@index([createdAt])
  @@map("self_service_idempotency")
}

model SelfServiceAuditEvent {
  id          String             @id @default(uuid()) @db.Uuid
  portal      SelfServicePortal?
  action      String
  outcome     String
  challengeId String?            @map("challenge_id") @db.Uuid
  sessionId   String?            @map("session_id") @db.Uuid
  subjectHash String?            @map("subject_hash")
  ipHash      String?            @map("ip_hash")
  metadata    Json?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([action, createdAt])
  @@index([sessionId, createdAt])
  @@map("self_service_audit_events")
}
