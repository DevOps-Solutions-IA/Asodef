# ASODEF web — environment template. Never commit real values.
# Vite only exposes vars prefixed with VITE_ to client code.

# Base API origin (no /api/v1 suffix - the client appends that). In
# production this is the same origin (Nginx proxies /api), so it can be
# left empty; set explicitly for local dev against a separately-run API.
VITE_API_URL=http://localhost:3000

# This site's own public origin, no trailing slash (US-019). Used for
# canonical/Open Graph/Twitter URLs in index.html (via Vite's %VITE_APP_URL%
# HTML replacement) and for the absolute URLs sitemap.xml/robots.txt
# require - set to the real production domain only at deploy time, never
# hardcoded in source.
VITE_APP_URL=http://localhost:5173
